# Postgres connection string. On Vercel this is set automatically by the Neon integration.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Public URL of your site (used for the Paystack return link)
BASE_URL=http://localhost:3000
# Paystack: dashboard.paystack.com > Settings > API Keys (sk_test_... while testing)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# Password for /admin (username can be anything)
ADMIN_PASSWORD=change-me
# Bank transfer details shown to customers
BANK_NAME=Your Bank Name
BANK_ACCOUNT_NUMBER=0123456789
BANK_ACCOUNT_NAME=Account Name
